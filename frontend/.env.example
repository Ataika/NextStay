# API Configuration
# Set VITE_USE_MOCK_API=false to use the real backend
VITE_USE_MOCK_API=false

# Base URL backend API
# Backend uses prefix /api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional local dev password bypass for the owner account.
# Put these in frontend/.env.local so they stay local to your machine.
# VITE_DEV_LOGIN_EMAIL=owner@example.com
# VITE_DEV_LOGIN_PASSWORD=change-me
# VITE_DEV_LOGIN_NAME=NextStay Owner
# VITE_AUTO_LOGIN_ENABLED=false
