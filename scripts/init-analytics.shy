#!/bin/bash

echo "Full initialisation."

# 1. Airflow: Сброс/Создание админа
echo " Настройка Airflow."
docker exec nextstay_airflow airflow users create \
    --username admin \
    --password admin \
    --firstname admin \
    --lastname admin \
    --role Admin \
    --email admin@nextstay.com || echo "Airflow user already exists"

# 2. Superset: Драйвер + Админ + Инициализация
echo "Настройка Superset."
# Установка драйвера в правильный путь
docker exec --user root nextstay_superset pip install psycopg2-binary --target /app/.venv/lib/python3.10/site-packages
# Создание админа
docker exec nextstay_superset superset fab create-admin \
    --username admin \
    --firstname admin \
    --lastname admin \
    --email admin@superset.com \
    --password admin
# База и роли
docker exec nextstay_superset superset db upgrade
docker exec nextstay_superset superset init

# 3. dbt: Проверка зависимостей
echo " Настройка dbt"
docker exec nextstay_dbt dbt deps

echo "Логины везде: admin / admin"
