# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend URL (redirects, links)
FRONTEND_URL=http://localhost:5173

# SMTP (booking notifications; optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nextstay.com
SMTP_FROM_NAME=NextStay

# Brevo OTP email (required for OTP login)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NextStay

# OTP/Auth security
OTP_EXP_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_SECRET=change-me
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_EXPIRES_MINUTES=720

# Dev password bypass (no OTP) for selected emails
DEV_BYPASS_EMAILS=nextstay@yandex.com,staff.uborka@yandex.com
DEV_BYPASS_PASSWORD=

# Registration policy
ALLOW_OWNER_SELF_REGISTER=false
